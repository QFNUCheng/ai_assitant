# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，绝不会提交到仓库。
# ------------------------------------------------------------------

# ---- 数据库（MySQL） ---------------------------------------------
# 本地开发可填 localhost；容器内连宿主机 MySQL 用 host.docker.internal
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=world

# ---- 大模型（DeepSeek） ------------------------------------------
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=你的_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.8

# ---- 向量化（阿里云 DashScope） ----------------------------------
DASHSCOPE_API_KEY=你的_dashscope_api_key
EMBEDDING_MODEL=text-embedding-v3

# ---- 知识库（可选，留空即使用默认值） ----------------------------
# KB_SCOPE 留空 = 全部五部（论语/孟子/礼记/荀子/孝经）
KB_SCOPE=
KB_COLLECTION=rujia
KB_RETRIEVAL_K=6
KB_EMBED_BATCH=10

# ---- 知识库上传接口 ----------------------------------------------
# 上传/删除需要请求头 X-Upload-Token 等于此值；留空 = 上传接口关闭（返回 503）
KB_UPLOAD_TOKEN=
# 单文件大小上限（MB）
KB_MAX_UPLOAD_MB=20
# 上传原件与登记表的存放目录（容器内路径，对应 compose 的 ./data/knowledge 挂载）
KB_DATA_DIR=
