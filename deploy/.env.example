# 复制为 .env 并填入真实值。.env 不进 git、不进镜像。
#
#   cp deploy/.env.example .env && vi .env
# ------------------------------------------------------------------

# ---- 数据库 ------------------------------------------------------
# 本机已有宝塔 MySQL 5.7（端口 3306）。本项目使用新建的独立库，不复用其他项目的库。
# 容器通过 host.docker.internal 访问宿主机 MySQL。
# 前提：MySQL 监听 0.0.0.0（或容器可达的地址），而不是仅 127.0.0.1。
#       若仅监听 127.0.0.1，容器将无法连接，届时需改 MySQL 绑定地址或用 host 网络模式。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=she_love_me
DB_PASSWORD=改成一个强密码
DB_NAME=she_love_me

# ---- 大模型（DeepSeek）--------------------------------------------
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=你的_deepseek_key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.8

# ---- 向量化（阿里云 DashScope）------------------------------------
DASHSCOPE_API_KEY=你的_dashscope_key
EMBEDDING_MODEL=text-embedding-v3

# ---- 知识库范围 ---------------------------------------------------
# 留空 = 全部五部（论语/孟子/礼记/荀子/孝经），首次构建约 30 万 token 的 embedding 调用。
# 想先小规模验证可只填一部，例如：KB_SCOPE=论语
KB_SCOPE=
KB_COLLECTION=rujia
KB_RETRIEVAL_K=6
KB_EMBED_BATCH=10

# ---- 知识库上传接口 -----------------------------------------------
# 上传/删除需要请求头 X-Upload-Token 等于此值；留空 = 上传接口关闭（返回 503）
# 生成方法：openssl rand -hex 24
KB_UPLOAD_TOKEN=
# 单文件大小上限（MB）。注意同步调整 nginx 的 client_max_body_size。
KB_MAX_UPLOAD_MB=20
